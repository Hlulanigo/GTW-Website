{
  "name": "the-gtw",
  "version": "1.0.0",
  "scripts": {
    "dev": "(cd web && npm run dev) & PORT=5000 npx tsx server/index.ts",
    "server:dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "cross-env NODE_ENV=production node server_dist/index.js",
    "web:build": "cd web && npm run build",
    "build": "npm run web:build && npm run server:build",
    "db:push": "drizzle-kit push",
    "db:migrate:privacy": "tsx server/scripts/20260128_add_privacy_migration.ts",
    "db:migrate:delivery": "tsx server/scripts/20260128_add_delivery_columns.ts",
    "db:seed": "tsx server/scripts/seed.ts",
    "check:types": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@types/leaflet": "^1.9.22",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "esbuild": "^0.28.2",
    "express": "^4.22.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "http-proxy-middleware": "^3.0.7",
    "jest": "^30.5.1",
    "leaflet": "^1.9.4",
    "openai": "^6.49.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "ws": "^8.21.3",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.1.10",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.6.2",
    "source-map": "^0.7.6",
    "supertest": "^7.2.2",
    "typescript": "~5.9.2",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
